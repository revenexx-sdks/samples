# Copy to `.env` and fill in your values. Never commit a real key.
#
# These variables are read by the samples in this repo.

# Your Revenexx API endpoint (the gateway). Default if unset:
REVENEXX_API_URL=https://api.revenexx.com

# The tenant your requests are scoped to (sent as the X-Revenexx-Tenant header).
REVENEXX_TENANT=

# --- Authentication: provide ONE of the following ---

# Bearer JWT for a signed-in user (Zitadel-issued). This is the production path
# for browser/mobile apps; the SDK sends it as the Authorization header.
REVENEXX_JWT=

# OR a gateway-managed scoped API key (starts with `rvxk_`). Server-side / trusted
# use only — never embed an API key in code shipped to a browser or mobile device.
REVENEXX_API_KEY=

# --- Workflow sample only (web/node `npm run workflow`) ---

# ISO currency for the sample cart/order (default EUR).
REVENEXX_CURRENCY=EUR

# Payment method code to charge. If unset, the workflow uses the first method
# returned by paymentsMethodsList().
REVENEXX_PAYMENT_METHOD=
